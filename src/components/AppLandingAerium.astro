---
import "photoswipe/style.css";

import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "./Container.astro";
import AppCubeLogoExplainer from "./AppCubeLogoExplainer.astro";
import HeroGooglePlaySpotlight from "./HeroGooglePlaySpotlight.astro";
import TestimonialsCarousel from "./TestimonialsCarousel.astro";
import WritingSystemsCloud from "./WritingSystemsCloud.astro";
import StockBlurbSection from "./StockBlurbSection.astro";

type Stat = { label: string; value: string };
type Feature = {
  title: string;
  body: string;
  imageSrc?: string;
  imageAlt?: string;
};
type FAQ = { q: string; a: string };
type StockImage = { src: string; alt: string };
type Testimonial = { quote: string; author: string };

type Props = {
  canonicalPath: string;
  title: string;
  description: string;
  themeColor: string; // e.g. "app-alphabets"
  appName: string;
  logoSrc?: string;
  logoAlt?: string;
  eyebrow?: string;
  headline: string;
  subhead: string;
  googlePlayUrl?: string;
  appStoreUrl?: string;
  screenshots: [string, string];
  centerScreenshot?: string;
  coverImage?: string;
  coverImageAlt?: string;
  /** Copy for the section below the hero (defaults match Alphabets). */
  introBlurbTitle?: string;
  introBlurbBody?: string;
  stockImages?: StockImage[];
  stats: Stat[];
  /** Shown above the stat grid (e.g. Google Play rating & downloads with Palme-style framing). */
  heroSpotlightStats?: Stat[];
  features: Feature[];
  /** When set, overrides the default “Everything you need” heading above the feature grid or rows */
  featuresSectionTitle?: string;
  featuresSectionSubtitle?: string;
  faqs?: FAQ[];
  testimonials?: Testimonial[];
  /** Second copy + stock collage below testimonials (mirrored layout on large screens). */
  postCarouselBlurb?: {
    title: string;
    body: string;
    stockImages: StockImage[];
  };
  writingSystemsWithSigns?: string[];
  writingSystemsTitle?: string;
  writingSystemsSubtitle?: string;
  termsUrl?: string;
  privacyUrl?: string;
  ogImage?: string;
  /** YouTube video ID only (from youtube.com/watch?v=…) for an embedded app preview */
  youtubeVideoId?: string;
  youtubeVideoTitle?: string;
  /** Optional cube logo breakdown below FAQ: three visible faces with callouts (requires `logoSrc`). */
  cubeExplainer?: {
    heading?: string;
    intro?: string;
    faces: Array<{ position: "top" | "left" | "right"; body: string }>;
  };
};

const {
  canonicalPath,
  title,
  description,
  themeColor,
  appName,
  logoSrc,
  logoAlt,
  eyebrow,
  headline,
  subhead,
  googlePlayUrl,
  appStoreUrl,
  screenshots,
  centerScreenshot,
  coverImage,
  introBlurbTitle,
  introBlurbBody,
  stockImages,
  stats,
  heroSpotlightStats,
  features,
  featuresSectionTitle,
  featuresSectionSubtitle,
  faqs,
  testimonials,
  postCarouselBlurb,
  writingSystemsWithSigns,
  writingSystemsTitle,
  writingSystemsSubtitle,
  termsUrl,
  privacyUrl,
  ogImage,
  youtubeVideoId,
  youtubeVideoTitle,
  cubeExplainer,
} = Astro.props;

const cubeFacePositions = ["top", "left", "right"] as const;
const cubeFaces = cubeExplainer?.faces;
const cubeExplainerComplete =
  Boolean(logoSrc && cubeFaces?.length === 3) &&
  cubeFacePositions.every((pos) => cubeFaces?.some((f) => f.position === pos) ?? false);

const displayStats = stats.slice(0, 5);
const statSectionClass =
  displayStats.length >= 5
    ? "mx-auto mt-6 grid max-w-5xl gap-4 sm:mt-8 grid-cols-2 sm:grid-cols-3 lg:grid-cols-5"
    : displayStats.length >= 4
      ? "mx-auto mt-6 grid max-w-4xl gap-4 sm:mt-8 grid-cols-2 lg:grid-cols-4"
      : "mx-auto mt-6 grid max-w-3xl gap-4 sm:mt-8 grid-cols-2 sm:grid-cols-3";

const secondaryVar =
  themeColor === "app-freestyle" ? "var(--color-app-freestyle-orange)" : `var(--color-${themeColor}-secondary)`;

const themeStyle = `--app-primary: var(--color-${themeColor}-primary); --app-secondary: ${secondaryVar};`;

/** Stronger cyan/blue ambience on Alphabets so hero glow reads clearly on zinc-950. */
const isAlphabetsTheme = themeColor === "app-alphabets";
const heroGlowTopPrimaryPct = isAlphabetsTheme ? 52 : 22;
const heroGlowBottomSecondaryPct = isAlphabetsTheme ? 24 : 16;
const heroGlowScreenshotPrimaryPct = isAlphabetsTheme ? 48 : 18;
const heroGlowTopOrbClass = isAlphabetsTheme ? "h-[48rem] w-[80rem]" : "h-[42rem] w-[72rem]";

const featuresAreRich = features.some((f) => Boolean(f.imageSrc));
const reviewsHeadingId = `reviews-heading-${themeColor}`;

type FeatureForRich = Feature & {
  featurePswpIndex?: number;
  featurePswpId?: string;
};

type FeaturePswpSlide = {
  pid: string;
  src: string;
  width: number;
  height: number;
  alt: string;
};

const featurePswpSlides: FeaturePswpSlide[] = [];
const featuresForRichLayout: FeatureForRich[] = features.map((f) => {
  if (!f.imageSrc) return f;
  const idx = featurePswpSlides.length;
  const pid = `feature-pswp-${idx}`;
  featurePswpSlides.push({
    pid,
    src: f.imageSrc,
    /** Placeholder ratio for phone screenshots; PhotoSwipe fits to viewport. */
    width: 1170,
    height: 2532,
    alt: f.imageAlt ?? f.title,
  });
  return { ...f, featurePswpIndex: idx, featurePswpId: pid };
});

/** Embed params: fewer on-screen controls where YouTube honours them (often still shows minimal UI on tap). */
const youtubeEmbedQuery = youtubeVideoId
  ? `?${new URLSearchParams({
    controls: "0",
    modestbranding: "1",
    rel: "0",
  }).toString()}`
  : "";
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} ogImage={ogImage ?? coverImage}>
  <div style={themeStyle} class="relative" data-app-theme={themeColor}>
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 z-0 overflow-hidden" data-app-landing-fixed-glow>
      <div class="absolute inset-[-12%]" data-app-landing-glow-parallax>
        <div
          class="absolute top-[36%] left-1/2 h-[48rem] w-[min(94vw,88rem)] -translate-x-1/2 -translate-y-1/2 rounded-full blur-3xl"
          style={`opacity: ${isAlphabetsTheme ? 0.82 : 0.66}; background: radial-gradient(closest-side, color-mix(in oklab, var(--app-primary) ${isAlphabetsTheme ? 42 : 34}%, transparent), transparent);`}
        >
        </div>
        <div
          class="absolute bottom-[-8%] left-1/2 h-[min(42vh,28rem)] w-[min(100vw,78rem)] -translate-x-1/2 rounded-full blur-3xl"
          style={`opacity: ${isAlphabetsTheme ? 0.62 : 0.52}; background: radial-gradient(closest-side, color-mix(in oklab, var(--app-secondary) 38%, transparent), transparent);`}
        >
        </div>
      </div>
    </div>

    <div class="relative z-10">
      <section class="relative overflow-visible pt-12 sm:pt-16">
        <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
          {
            isAlphabetsTheme ? (
              <div class:list={["absolute -top-56 left-1/2 flex -translate-x-1/2 justify-center", heroGlowTopOrbClass]}>
                <div
                  class="h-full w-full rounded-full blur-3xl"
                  style={`background: radial-gradient(closest-side, color-mix(in oklab, var(--app-primary) ${heroGlowTopPrimaryPct}%, transparent), transparent);`}
                />
              </div>
            ) : (
              <div
                class:list={["absolute -top-56 left-1/2 -translate-x-1/2 rounded-full blur-3xl", heroGlowTopOrbClass]}
                style={`background: radial-gradient(closest-side, color-mix(in oklab, var(--app-primary) ${heroGlowTopPrimaryPct}%, transparent), transparent);`}
              />
            )
          }
          {
            isAlphabetsTheme ? (
              <div
                class="absolute -top-36 left-[18%] h-[34rem] w-[34rem] rounded-full blur-3xl"
                style={`background: radial-gradient(closest-side, color-mix(in oklab, var(--app-primary) 36%, transparent), transparent);`}
              />
            ) : null
          }
          {
            isAlphabetsTheme ? (
              <div class="absolute -bottom-72 left-1/2 flex h-[42rem] w-[72rem] -translate-x-1/2 justify-center">
                <div
                  class="h-full w-full rounded-full blur-3xl"
                  style={`background: radial-gradient(closest-side, color-mix(in oklab, var(--app-secondary) ${heroGlowBottomSecondaryPct}%, transparent), transparent);`}
                />
              </div>
            ) : (
              <div
                class="absolute -bottom-72 left-1/2 h-[42rem] w-[72rem] -translate-x-1/2 rounded-full blur-3xl"
                style={`background: radial-gradient(closest-side, color-mix(in oklab, var(--app-secondary) ${heroGlowBottomSecondaryPct}%, transparent), transparent);`}
              />
            )
          }
          <div class="absolute inset-0 bg-gradient-to-b from-white/0 via-white/0 to-transparent"></div>
        </div>

        <Container>
          <div class="mx-auto max-w-3xl text-center">
            {
              logoSrc ? (
                <div class="mb-5">
                  <img
                    src={logoSrc}
                    alt={logoAlt ?? `${appName} app logo`}
                    class="mx-auto h-24 w-24 object-contain sm:h-28 sm:w-28"
                    loading="eager"
                    decoding="async"
                  />
                </div>
              ) : null
            }
            {
              eyebrow ? (
                <p
                  class="inline-flex items-center rounded-full bg-white/5 px-3 py-1 text-xs font-medium text-zinc-200 ring-1 ring-white/10">
                  {eyebrow}
                </p>
              ) : null
            }

            <h1 class="mt-5 text-4xl font-semibold tracking-tight text-balance text-white sm:text-6xl">
              {headline}
            </h1>
            <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-pretty text-zinc-200 sm:text-xl">
              {subhead}
            </p>

            <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
              {
                googlePlayUrl ? (
                  <a
                    class="inline-flex focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white/60"
                    href={googlePlayUrl}
                    rel="noopener noreferrer"
                    target="_blank"
                    aria-label="Get it on Google Play"
                  >
                    <img
                      src="/google-play-badges/GetItOnGooglePlay_Badge_Web_color_English.svg"
                      alt="Get it on Google Play"
                      class="h-14 w-auto sm:h-16"
                      decoding="async"
                    />
                  </a>
                ) : null
              }
              {
                appStoreUrl ? (
                  <a class="btn btn-secondary" href={appStoreUrl} rel="noopener noreferrer" target="_blank">
                    Download on the App Store
                  </a>
                ) : null
              }
            </div>
          </div>

          <div class="relative mx-auto mt-12 max-w-5xl pb-10 sm:mt-16 sm:pb-14">
            <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
              <div
                class:list={[
                  "absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 rounded-full blur-2xl",
                  isAlphabetsTheme ? "h-[33rem] w-[33rem] sm:h-[38rem] sm:w-[38rem]" : "h-[26rem] w-[26rem]",
                ]}
                style={isAlphabetsTheme
                  ? `background: radial-gradient(ellipse 68% 66% at 50% 44%, color-mix(in oklab, var(--app-primary) ${heroGlowScreenshotPrimaryPct}%, transparent) 50%, transparent 76%);`
                  : `background: radial-gradient(closest-side, color-mix(in oklab, var(--app-primary) ${heroGlowScreenshotPrimaryPct}%, transparent), transparent);`}
              >
              </div>
            </div>

            <div class="relative grid place-items-center">
              <div class="w-full sm:hidden">
                <div class="mx-auto max-w-[18rem]">
                  <img
                    src={centerScreenshot ?? screenshots[0]}
                    alt={`${appName} app screenshot`}
                    class="block h-auto max-h-[28rem] w-full object-contain"
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                  />
                </div>
              </div>
              <div class="relative hidden h-[34rem] w-full sm:block" data-app-landing-hero-depth-panel>
                <div
                  class="device device-left"
                  data-app-landing-hero-depth-layer
                  data-side="left"
                  data-base-rotate="-10"
                  data-base-y="22"
                  data-parallax-mult="1"
                  style="transform: rotate(-10deg);"
                >
                  <img src={screenshots[0]} alt={`${appName} app screenshot`} class="h-full w-full object-contain" />
                </div>
                <div
                  class="device device-right"
                  data-app-landing-hero-depth-layer
                  data-side="right"
                  data-base-rotate="10"
                  data-base-y="22"
                  data-parallax-mult="1"
                  style="transform: rotate(10deg);"
                >
                  <img src={screenshots[1]} alt={`${appName} app screenshot`} class="h-full w-full object-contain" />
                </div>

                <div
                  class="device device-center hidden sm:block"
                  data-app-landing-hero-depth-layer
                  data-base-transform="translateX(-50%)"
                  data-base-y="0"
                  data-parallax-mult="0.85"
                  style="transform: translateX(-50%);"
                >
                  {
                    centerScreenshot ? (
                      <img
                        src={centerScreenshot}
                        alt={`${appName} app screenshot`}
                        class="h-full w-full object-contain"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div
                        class="h-full w-full"
                        style={`background: linear-gradient(135deg, color-mix(in oklab, var(--app-primary) 18%, black), color-mix(in oklab, var(--app-secondary) 14%, black));`}
                      />
                    )
                  }
                </div>
              </div>
            </div>
          </div>

          {heroSpotlightStats?.length ?
            <HeroGooglePlaySpotlight stats={heroSpotlightStats} /> : null}

          <div class={statSectionClass}>
            {
              displayStats.map((s, index) => (
                <div
                  class:list={[
                    "card relative overflow-hidden p-5 text-center",
                    displayStats.length === 3 && index === 2 && "max-sm:col-span-2",
                  ]}
                >
                  <div
                    aria-hidden="true"
                    class="pointer-events-none absolute inset-0 opacity-60"
                    style={`background: radial-gradient(350px circle at 50% 25%, color-mix(in oklab, var(--app-primary) 18%, transparent), transparent 60%);`}
                  />
                  <div class="relative">
                    <div class="text-xs font-semibold text-zinc-300">{s.label}</div>
                    <div class="mt-2 text-2xl font-semibold tracking-tight text-white">{s.value}</div>
                  </div>
                </div>
              ))
            }
          </div>
        </Container>
      </section>

      {
        youtubeVideoId ? (
          <section class="py-10 sm:py-14">
            <Container>
              <div class="mx-auto mt-8 max-w-3xl">
                <div class="relative aspect-video w-full overflow-hidden rounded-xl bg-black ring-1 ring-white/10">
                  <iframe
                    class="absolute inset-0 h-full w-full"
                    src={`https://www.youtube-nocookie.com/embed/${youtubeVideoId}${youtubeEmbedQuery}`}
                    title={youtubeVideoTitle ?? `${appName} app preview on YouTube`}
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                    loading="lazy"
                  />
                </div>
              </div>
            </Container>
          </section>
        ) : null
      }

      <StockBlurbSection
        title={introBlurbTitle ?? "Designed for quick curiosity and deep rabbit holes"}
        body={introBlurbBody ??
          "Open it for a minute, stay for an hour. The experience is structured, calm, and satisfying, so learning feels effortless."}
        stockImages={stockImages}
      />

      <section class="py-12 sm:py-16">
        <Container>
          <div class="mx-auto max-w-2xl text-center">
            <h2 class="text-2xl font-semibold tracking-tight text-balance text-white sm:text-3xl">
              {featuresSectionTitle ?? "Everything you need"}
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-zinc-300">
              {featuresSectionSubtitle ?? "Built to be readable, interactive, and genuinely useful, not just pretty."}
            </p>
          </div>

          {
            featuresAreRich ? (
              <div class="mx-auto mt-10 max-w-5xl space-y-12 sm:space-y-16" data-app-feature-pswp-root>
                {featuresForRichLayout.map((f, i) => (
                  <div
                    class:list={[
                      "flex flex-col gap-4 md:items-center lg:gap-8",
                      i % 2 === 1 ? "md:flex-row-reverse" : "md:flex-row",
                    ]}
                  >
                    {f.imageSrc ? (
                      <div
                        class:list={[
                          "relative z-20 flex justify-center md:block md:w-5/12",
                          i === 0 ? "" : "md:-mt-14 lg:-mt-20",
                          "overflow-visible",
                        ]}
                      >
                        <button
                          type="button"
                          class="group relative z-10 inline-block max-w-[520px] cursor-zoom-in border-0 bg-transparent p-0 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white/60"
                          aria-label={`Browse screenshots (opens gallery): ${f.imageAlt ?? f.title}`}
                          data-app-feature-pswp-trigger
                          data-app-feature-pswp-index={String(f.featurePswpIndex ?? 0)}
                          data-app-feature-pswp-id={f.featurePswpId ?? ""}
                        >
                          <img
                            src={f.imageSrc}
                            alt={f.imageAlt ?? f.title}
                            class="relative block h-auto max-h-[420px] w-auto max-w-full rounded-none object-contain sm:max-h-[520px]"
                            data-app-feature-parallax
                            data-parallax-speed={String(0.6 + (i % 3) * 0.15)}
                            loading="lazy"
                            decoding="async"
                            draggable="false"
                          />
                          <span
                            aria-hidden="true"
                            class="pointer-events-none absolute inset-0 ring-1 ring-transparent transition group-hover:ring-white/15"
                          />
                          <span
                            aria-hidden="true"
                            class="pointer-events-none absolute right-2 bottom-2 inline-flex max-w-[calc(100%-1rem)] items-center rounded-full bg-black/55 px-2.5 py-1 text-[11px] font-medium text-white/90 opacity-0 shadow-sm ring-1 ring-white/10 backdrop-blur transition group-hover:opacity-100"
                          >
                            Click to browse
                          </span>
                        </button>
                      </div>
                    ) : null}
                    <div class="md:flex md:w-7/12 md:flex-col md:justify-center">
                      <h3 class="text-lg font-semibold text-white sm:text-xl">{f.title}</h3>
                      <p class="mt-3 text-sm leading-relaxed text-zinc-300 sm:text-base">{f.body}</p>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                {features.map((f) => (
                  <div class="card relative overflow-hidden p-6">
                    <div
                      aria-hidden="true"
                      class="pointer-events-none absolute inset-0 opacity-60"
                      style={`background: radial-gradient(450px circle at 20% 20%, color-mix(in oklab, var(--app-primary) 16%, transparent), transparent 55%);`}
                    />
                    <div class="relative">
                      <h3 class="text-sm font-semibold text-white">{f.title}</h3>
                      <p class="mt-2 text-sm leading-relaxed text-zinc-300">{f.body}</p>
                    </div>
                  </div>
                ))}
              </div>
            )
          }
        </Container>
      </section>

      {
        writingSystemsWithSigns?.length ? (
          <section class="overflow-x-clip py-12 sm:py-16">
            <Container class="!max-w-7xl">
              <div class="mx-auto max-w-2xl text-center">
                <h2 class="text-2xl font-semibold tracking-tight text-balance text-white sm:text-3xl">
                  {writingSystemsTitle ?? "Writing systems with signs"}
                </h2>
                <p class="mt-3 text-sm leading-relaxed text-zinc-300">
                  {writingSystemsSubtitle ??
                    "A selection of the writing systems you can study with character signs inside the app."}
                </p>
              </div>

              <div class="relative isolate mx-auto mt-10 w-full">
                <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -inset-y-32 z-0 opacity-70">
                  <div
                    class="absolute top-1/2 left-1/2 h-[46rem] w-[min(110vw,88rem)] -translate-x-1/2 -translate-y-1/2 rounded-full blur-3xl"
                    style={`background: radial-gradient(closest-side, color-mix(in oklab, var(--app-primary) 26%, transparent), transparent);`}
                  />
                  <div
                    class="absolute bottom-[-20%] left-1/2 h-[28rem] w-[min(100vw,72rem)] -translate-x-1/2 rounded-full blur-3xl"
                    style={`background: radial-gradient(closest-side, color-mix(in oklab, var(--app-primary) 14%, transparent), transparent);`}
                  />
                </div>
                <div class="relative z-10 w-full">
                  <WritingSystemsCloud words={writingSystemsWithSigns} />
                </div>
              </div>
            </Container>
          </section>
        ) : null
      }

      {
        testimonials?.length ? (
          <section class="py-12 sm:py-16">
            <Container>
              <div class="mx-auto max-w-2xl text-center">
                <h2
                  id={reviewsHeadingId}
                  class="text-2xl font-semibold tracking-tight text-balance text-white sm:text-3xl"
                >
                  What people are saying
                </h2>
                <p class="mt-3 text-sm leading-relaxed text-zinc-300">Reviews from Google Play.</p>
              </div>

              <TestimonialsCarousel testimonials={testimonials} labelledBy={reviewsHeadingId} />
            </Container>
          </section>
        ) : null
      }

      {
        postCarouselBlurb?.stockImages?.length ? (
          <StockBlurbSection
            title={postCarouselBlurb.title}
            body={postCarouselBlurb.body}
            stockImages={postCarouselBlurb.stockImages}
            mirror
            imageLoading="lazy"
          />
        ) : null
      }

      {
        faqs?.length ? (
          <section class="py-12 sm:py-16">
            <Container>
              <div class="mx-auto max-w-2xl text-center">
                <h2 class="text-2xl font-semibold tracking-tight text-balance text-white sm:text-3xl">FAQ</h2>
                <p class="mt-3 text-sm leading-relaxed text-zinc-300">A few quick answers.</p>
              </div>

              <div class="mx-auto mt-10 max-w-3xl space-y-3">
                {faqs.map((f) => (
                  <details class="card group cursor-pointer overflow-hidden p-5" data-app-faq-details>
                    <summary class="cursor-pointer list-none text-sm font-semibold text-white">
                      <span class="inline-flex items-center gap-2">
                        <span
                          class="inline-block h-2 w-2 rounded-full"
                          style={`background: color-mix(in oklab, var(--app-primary) 70%, white);`}
                        />
                        {f.q}
                      </span>
                    </summary>
                    <p class="mt-3 text-sm leading-relaxed text-zinc-300">{f.a}</p>
                  </details>
                ))}
              </div>
            </Container>
          </section>
        ) : null
      }

      {
        cubeExplainerComplete && cubeExplainer ? (
          <section class="overflow-x-clip pt-10 pb-3 sm:pt-14 sm:pb-4">
            <Container>
              <AppCubeLogoExplainer
                logoSrc={logoSrc!}
                logoAlt={logoAlt ?? `${appName} app logo`}
                heading={cubeExplainer.heading}
                intro={cubeExplainer.intro}
                instanceId={`cube-${themeColor}`}
                faces={cubeExplainer.faces}
              />
            </Container>
          </section>
        ) : null
      }

      <section class:list={[cubeExplainerComplete && cubeExplainer ? "pt-5 pb-12 sm:pt-6 sm:pb-16" : "py-12 sm:py-16"]}>
        <Container>
          <div class="card relative overflow-hidden p-6 sm:p-10">
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 opacity-90"
              style={`background: radial-gradient(1000px circle at 20% 20%, color-mix(in oklab, var(--app-primary) 22%, transparent), transparent 60%), radial-gradient(1000px circle at 80% 60%, color-mix(in oklab, var(--app-secondary) 18%, transparent), transparent 62%);`}
            >
            </div>
            <div class="relative flex flex-col items-center justify-between gap-6 text-center sm:flex-row sm:text-left">
              <div class="flex w-full flex-col items-center gap-4 sm:w-auto sm:flex-row sm:items-start sm:gap-5">
                {
                  logoSrc ? (
                    <img
                      src={logoSrc}
                      alt={logoAlt ?? `${appName} app logo`}
                      class="h-16 w-16 shrink-0 object-contain sm:h-20 sm:w-20"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : null
                }

                <div>
                  <h2 class="text-2xl font-semibold tracking-tight text-balance text-white sm:text-3xl">
                    Explore {appName}
                  </h2>
                  <p class="mt-3 max-w-2xl text-sm leading-relaxed text-zinc-200">
                    {description}
                  </p>
                </div>
              </div>
              {
                googlePlayUrl ? (
                  <div class="flex shrink-0 flex-col gap-3 sm:flex-row sm:items-center">
                    <a
                      class="inline-flex focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white/60"
                      href={googlePlayUrl}
                      rel="noopener noreferrer"
                      target="_blank"
                      aria-label="Get it on Google Play"
                    >
                      <img
                        src="/google-play-badges/GetItOnGooglePlay_Badge_Web_color_English.svg"
                        alt="Get it on Google Play"
                        class="h-14 w-auto sm:h-16"
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                  </div>
                ) : null
              }
            </div>
          </div>

          {
            (termsUrl || privacyUrl) && (
              <div class="mt-8 text-center text-sm text-zinc-400">
                {termsUrl ? (
                  <a class="underline decoration-white/20 underline-offset-4 hover:text-white" href={termsUrl}>
                    Terms
                  </a>
                ) : null}
                {termsUrl && privacyUrl ? " · " : null}
                {privacyUrl ? (
                  <a class="underline decoration-white/20 underline-offset-4 hover:text-white" href={privacyUrl}>
                    Privacy
                  </a>
                ) : null}
              </div>
            )
          }
        </Container>
      </section>
    </div>
  </div>

  {
    featuresAreRich && featurePswpSlides.length > 0 ? (
      <script
        id="app-feature-pswp-slides"
        type="application/json"
        set:html={JSON.stringify(featurePswpSlides).replaceAll("<", "\\u003c")}
        />
    ) : null
  }

  <script>
    import PhotoSwipe from "photoswipe";

    /** Owns the open gallery; avoid `window.pswp` (PhotoSwipe/Lightbox use it internally). */
    let activeFeaturePswp: PhotoSwipe | null = null;

    function initFixedGlowParallax(): void {
      const parallaxEl = document.querySelector<HTMLElement>("[data-app-landing-glow-parallax]");
      if (!parallaxEl) return;
      const el = parallaxEl;

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        el.style.removeProperty("transform");
        return;
      }

      const strength = 0.075;
      const maxPx = 72;
      let rafId = 0;

      function apply(): void {
        rafId = 0;
        const y = Math.min(window.scrollY * strength, maxPx);
        el.style.transform = `translate3d(0, ${y}px, 0)`;
      }

      function onScrollOrResize(): void {
        if (rafId !== 0) return;
        rafId = window.requestAnimationFrame(apply);
      }

      apply();
      window.addEventListener("scroll", onScrollOrResize, { passive: true });
      window.addEventListener("resize", onScrollOrResize);
    }

    initFixedGlowParallax();

    function initHeroScreenshotScrollDepth(): void {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        return;
      }

      const panel = document.querySelector<HTMLElement>("[data-app-landing-hero-depth-panel]");
      if (!panel) return;

      const layers = Array.from(panel.querySelectorAll<HTMLElement>("[data-app-landing-hero-depth-layer]"));
      if (!layers.length) return;

      const layerData = layers.map((layer) => {
        const baseY = Number.parseFloat(layer.getAttribute("data-base-y") ?? "0") || 0;
        const mult = Number.parseFloat(layer.getAttribute("data-parallax-mult") ?? "1") || 1;
        const side = layer.getAttribute("data-side");
        const baseRotate = Number.parseFloat(layer.getAttribute("data-base-rotate") ?? "0") || 0;
        const baseTransform = layer.getAttribute("data-base-transform") ?? "";
        const dir = side === "left" ? -1 : side === "right" ? 1 : 0;
        return { layer, baseY, mult, side, baseRotate, baseTransform, dir };
      });

      let rafId = 0;
      let isAttached = false;

      function apply(): void {
        rafId = 0;

        const maxPx = 128;
        const strength = 0.14;
        const travel = Math.min(window.scrollY * strength, maxPx);
        const progress = maxPx > 0 ? Math.max(0, Math.min(1, travel / maxPx)) : 0;
        const fanX = 64;
        const fanRot = 14;

        for (const d of layerData) {
          const y = d.baseY - travel * d.mult;
          const z = d.mult >= 1 ? 18 : 10;

          if (d.side === "left" || d.side === "right") {
            const x = d.dir * fanX * progress;
            const rot = d.baseRotate + d.dir * fanRot * progress;
            d.layer.style.transform = `rotate(${rot}deg) translate3d(${x}px, ${y}px, ${z}px)`;
            continue;
          }

          if (!d.baseTransform) continue;
          d.layer.style.transform = `${d.baseTransform} translate3d(0, ${y}px, ${z}px)`;
        }
      }

      function onScrollOrResize(): void {
        if (!isAttached) return;
        if (rafId !== 0) return;
        rafId = window.requestAnimationFrame(apply);
      }

      apply();
      const opts: AddEventListenerOptions = { passive: true };

      function attach(): void {
        if (isAttached) return;
        isAttached = true;
        window.addEventListener("scroll", onScrollOrResize, opts);
        window.addEventListener("resize", onScrollOrResize);
        window.visualViewport?.addEventListener("scroll", onScrollOrResize, opts);
        window.visualViewport?.addEventListener("resize", onScrollOrResize);
        onScrollOrResize();
      }

      function detach(): void {
        if (!isAttached) return;
        isAttached = false;
        window.removeEventListener("scroll", onScrollOrResize);
        window.removeEventListener("resize", onScrollOrResize);
        window.visualViewport?.removeEventListener("scroll", onScrollOrResize);
        window.visualViewport?.removeEventListener("resize", onScrollOrResize);
      }

      attach();

      const io = new IntersectionObserver(
        (entries) => {
          const entry = entries[0];
          if (!entry) return;
          if (entry.isIntersecting) attach();
          else detach();
        },
        // Keep it active a bit before/after it's visible so it doesn't "snap" on fast scroll.
        { root: null, threshold: 0, rootMargin: "250px 0px 250px 0px" },
      );
      io.observe(panel);
    }

    initHeroScreenshotScrollDepth();

    function initFeatureScreenshotParallax(): void {
      const els = Array.from(document.querySelectorAll<HTMLElement>("[data-app-feature-parallax]"));
      if (!els.length) return;

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        for (const el of els) el.style.removeProperty("transform");
        return;
      }

      const maxPx = 64;
      let rafId = 0;

      function apply(): void {
        rafId = 0;
        const viewportH = window.innerHeight || 1;
        const half = viewportH / 2;

        for (const el of els) {
          const rect = el.getBoundingClientRect();
          if (rect.height <= 0) continue;

          const mid = rect.top + rect.height / 2;
          const norm = (mid - half) / half; // -1 (top) .. 0 (center) .. 1 (bottom)
          const clamped = Math.max(-1, Math.min(1, norm));

          const speed = Number.parseFloat(el.getAttribute("data-parallax-speed") ?? "0.25");
          const strength = Math.max(0, Math.min(1, speed));
          const offset = -clamped * maxPx * strength;
          const scale = 1 + 0.02 * strength;
          el.style.transform = `translate3d(0, ${offset.toFixed(2)}px, 0) scale(${scale.toFixed(3)})`;
        }
      }

      function onScrollOrResize(): void {
        if (rafId !== 0) return;
        rafId = window.requestAnimationFrame(apply);
      }

      apply();
      window.addEventListener("scroll", onScrollOrResize, { passive: true });
      window.addEventListener("resize", onScrollOrResize);
      window.visualViewport?.addEventListener("scroll", onScrollOrResize, { passive: true });
      window.visualViewport?.addEventListener("resize", onScrollOrResize);
    }

    initFeatureScreenshotParallax();

    function initFaqWholeCardToggle(): void {
      document.querySelectorAll<HTMLDetailsElement>("[data-app-faq-details]").forEach((el) => {
        el.addEventListener("click", (e) => {
          const target = e.target;
          if (!(target instanceof Element)) return;
          if (target.closest("summary")) return;
          if (target.closest("a, button, input, textarea, select")) return;
          el.open = !el.open;
        });
      });
    }

    initFaqWholeCardToggle();

    type FeaturePswpSlideSeed = {
      pid: string;
      src: string;
      width: number;
      height: number;
      alt: string;
    };

    function readFeaturePswpSlides(): FeaturePswpSlideSeed[] {
      const el = document.getElementById("app-feature-pswp-slides");
      if (!el?.textContent) return [];
      try {
        const parsed: unknown = JSON.parse(el.textContent);
        return Array.isArray(parsed) ? (parsed as FeaturePswpSlideSeed[]) : [];
      } catch {
        return [];
      }
    }

    function closeStaleFeaturePhotoSwipe(): void {
      if (!activeFeaturePswp) return;
      try {
        activeFeaturePswp.destroy();
        // `destroy()` may only schedule `close()` on the first call; call again if needed.
        if (activeFeaturePswp) activeFeaturePswp.destroy();
      } catch {
        /* ignore */
      }
    }

    function initFeaturePhotoSwipeCarousel(): void {
      const slides = readFeaturePswpSlides();
      const root = document.querySelector("[data-app-feature-pswp-root]");
      if (!root || !slides.length) return;

      const dataSource = slides.map((s) => ({
        src: s.src,
        width: s.width,
        height: s.height,
        alt: s.alt,
        pid: s.pid,
      }));

      root.querySelectorAll<HTMLButtonElement>("[data-app-feature-pswp-trigger]").forEach((btn) => {
        btn.addEventListener("click", (event) => {
          const raw = btn.getAttribute("data-app-feature-pswp-index");
          const idx = raw == null || raw === "" ? Number.NaN : Number(raw);
          if (!Number.isFinite(idx) || idx < 0) return;

          closeStaleFeaturePhotoSwipe();

          const ev = event as MouseEvent;
          const initialPointerPos = ev.clientX || ev.clientY ? { x: ev.clientX, y: ev.clientY } : null;

          const pswp = new PhotoSwipe({
            dataSource,
            index: idx,
            loop: slides.length >= 3,
            bgOpacity: 0.92,
            padding: { top: 20, bottom: 20, left: 16, right: 16 },
            initialPointerPos,
            /** Avoid thumb-zoom pipeline issues; opens reliably without waiting on opener timing. */
            showHideAnimationType: "none",
            showHideOpacity: false,
          });

          pswp.addFilter("thumbEl", (thumbEl, itemData) => {
            const pid = typeof itemData.pid === "string" ? itemData.pid : "";
            if (!pid) return thumbEl ?? document.createElement("div");
            const trigger = root.querySelector(`button[data-app-feature-pswp-id="${pid}"]`);
            const img = trigger?.querySelector("img");
            return img ?? thumbEl ?? document.createElement("div");
          });

          pswp.addFilter("placeholderSrc", (placeholderSrc, content) => {
            const pid = typeof content.data.pid === "string" ? content.data.pid : "";
            if (!pid) return placeholderSrc;
            const trigger = root.querySelector(`button[data-app-feature-pswp-id="${pid}"]`);
            const img = trigger?.querySelector("img");
            const src = img?.currentSrc || img?.src;
            return src || placeholderSrc;
          });

          activeFeaturePswp = pswp;
          pswp.on("destroy", () => {
            if (activeFeaturePswp === pswp) activeFeaturePswp = null;
          });
          pswp.init();
        });
      });
    }

    initFeaturePhotoSwipeCarousel();
  </script>

  <style>
    .device {
      position: absolute;
      overflow: visible;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }

    .device-left {
      left: 2%;
      top: 10%;
      width: 52%;
      height: 86%;
    }

    .device-right {
      right: 2%;
      top: 10%;
      width: 52%;
      height: 86%;
    }

    .device-center {
      left: 50%;
      top: 3%;
      width: 42%;
      height: 94%;
    }

    [data-app-landing-glow-parallax] {
      will-change: transform;
      contain: paint;
      transform: translateZ(0);
    }

    [data-app-landing-hero-depth-panel] {
      contain: layout;
    }

    [data-app-landing-hero-depth-layer] {
      will-change: transform;
      backface-visibility: hidden;
      transform-style: preserve-3d;
    }

    [data-app-feature-parallax] {
      will-change: transform;
    }
  </style>
</BaseLayout>
