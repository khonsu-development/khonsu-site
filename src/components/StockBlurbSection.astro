---
import Container from "./Container.astro";

export type StockImage = { src: string; alt: string };

type Props = {
  title: string;
  body: string;
  stockImages?: StockImage[];
  /** Desktop: collage on the left, copy on the right. Mobile keeps headline first. */
  mirror?: boolean;
  /**
   * Use `eager` (default) so collage images start loading with the page instead of
   * waiting until scroll (`lazy` defers until near viewport).
   */
  imageLoading?: "eager" | "lazy";
};

const {
  title,
  body,
  stockImages,
  mirror = false,
  imageLoading = "eager",
} = Astro.props;

/** Decorative overlapping rounded tiles; max 5 (placement + base rotation on inner layer for scroll depth). */
const STOCK_POLAROID_LAYERS = [
  {
    place:
      "left-[3%] top-[10%] z-[2] h-[58%] max-h-[248px] w-[54%] sm:top-[12%]",
    rotateDeg: -5,
  },
  {
    place: "right-[0%] top-[4%] z-[4] h-[52%] max-h-[228px] w-[46%]",
    rotateDeg: 8,
  },
  {
    place: "left-[12%] bottom-[2%] z-[6] h-[48%] max-h-[210px] w-[42%]",
    rotateDeg: -6,
  },
  {
    place: "right-[10%] bottom-[10%] z-[5] h-[42%] max-h-[190px] w-[38%]",
    rotateDeg: 6,
  },
  {
    place: "left-[34%] top-[34%] z-[8] h-[38%] max-h-[168px] w-[34%]",
    rotateDeg: 3,
  },
] as const;
---

<section class="py-12 sm:py-16">
  <Container>
    <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
      <div
        class:list={[
          mirror
            ? "order-1 lg:order-2 lg:col-span-5 lg:col-start-8"
            : "lg:col-span-5",
        ]}
      >
        <h2
          class="text-2xl font-semibold tracking-tight text-balance text-white sm:text-3xl"
        >
          {title}
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-pretty text-zinc-300">
          {body}
        </p>
      </div>
      <div
        class:list={[
          mirror
            ? "order-2 lg:order-1 lg:col-span-7 lg:col-start-1"
            : "lg:col-span-7",
        ]}
      >
        {
          stockImages?.length === 2 ? (
            <div class="relative mt-5 sm:mt-6">
              <div
                aria-hidden="true"
                class="pointer-events-none absolute -inset-10 opacity-65"
                style={`background: radial-gradient(700px circle at 40% 25%, color-mix(in oklab, var(--app-primary) 16%, transparent), transparent 60%);`}
              />
              <div
                class="relative mx-auto h-[14rem] max-w-xl perspective-[1100px] [transform-style:preserve-3d] sm:h-[16rem]"
                data-stock-depth-panel
              >
                <div class="absolute top-1/2 left-1/2 w-[70%] -translate-x-[60%] -translate-y-[55%]">
                  <div
                    class="card overflow-hidden motion-safe:will-change-transform"
                    data-stock-depth-layer
                    data-base-rotate="-6"
                    data-depth-index="0"
                    style="transform: rotate(-6deg);"
                  >
                    <img
                      src={stockImages[0].src}
                      alt={stockImages[0].alt}
                      class="h-44 w-full object-cover sm:h-52"
                      loading={imageLoading}
                      decoding="async"
                      fetchpriority={imageLoading === "eager" ? "high" : undefined}
                    />
                  </div>
                </div>
                <div class="absolute top-1/2 left-1/2 w-[72%] -translate-x-[35%] -translate-y-[40%]">
                  <div
                    class="card overflow-hidden motion-safe:will-change-transform"
                    data-stock-depth-layer
                    data-base-rotate="4"
                    data-depth-index="1"
                    style="transform: rotate(4deg);"
                  >
                    <img
                      src={stockImages[1].src}
                      alt={stockImages[1].alt}
                      class="h-44 w-full object-cover sm:h-52"
                      loading={imageLoading}
                      decoding="async"
                    />
                  </div>
                </div>
              </div>
            </div>
          ) : stockImages && stockImages.length >= 3 ? (
            <div class="relative mt-6 sm:mt-7">
              <p class="sr-only">
                Decorative stock photographs of manuscripts and inscriptions;
                not screenshots of the app.
              </p>
              <div
                aria-hidden="true"
                class="pointer-events-none absolute -inset-x-8 -inset-y-10 opacity-70 sm:-inset-x-12"
                style={`background: radial-gradient(780px ellipse at 55% 35%, color-mix(in oklab, var(--app-primary) 12%, transparent), transparent 58%);`}
              />
              <div
                aria-hidden="true"
                class="relative mx-auto min-h-[min(72vw,360px)] w-full max-w-xl perspective-[1200px] sm:min-h-[380px] lg:max-w-2xl [transform-style:preserve-3d]"
                data-stock-depth-panel
              >
                {stockImages
                  .slice(0, STOCK_POLAROID_LAYERS.length)
                  .map((img, i) => {
                    const layer = STOCK_POLAROID_LAYERS[i] ?? STOCK_POLAROID_LAYERS[0];
                    return (
                      <div class:list={["absolute", layer.place]}>
                        <div
                          class="origin-center h-full w-full overflow-hidden rounded-lg motion-safe:will-change-transform"
                          data-stock-depth-layer
                          data-base-rotate={layer.rotateDeg}
                          data-depth-index={i}
                          style={`transform: rotate(${layer.rotateDeg}deg);`}
                        >
                          <img
                            src={img.src}
                            alt=""
                            class="block h-full w-full border-0 object-cover outline-none"
                            loading={imageLoading}
                            decoding="async"
                            fetchpriority={
                              i === 0 && imageLoading === "eager"
                                ? "high"
                                : undefined
                            }
                          />
                        </div>
                      </div>
                    );
                  })}
              </div>
            </div>
          ) : stockImages?.length ? (
            <div
              class="mt-4 grid gap-3 perspective-[1000px] [transform-style:preserve-3d] sm:mt-5 sm:grid-cols-3"
              data-stock-depth-panel
            >
              {stockImages.slice(0, 3).map((img, i) => (
                <div
                  class="card overflow-hidden motion-safe:will-change-transform"
                  data-stock-depth-layer
                  data-base-rotate="0"
                  data-depth-index={i}
                >
                  <img
                    src={img.src}
                    alt={img.alt}
                    class="h-28 w-full object-cover sm:h-32"
                    loading={imageLoading}
                    decoding="async"
                    fetchpriority={
                      i === 0 && imageLoading === "eager" ? "high" : undefined
                    }
                  />
                </div>
              ))}
            </div>
          ) : null
        }
      </div>
    </div>
  </Container>
</section>

<script>
  function initStockImageScrollDepth(): void {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return;
    }

    let rafId = 0;

    /**
     * Frames slide past each other at different rates (depth parallax).
     * Uses panel position in the viewport so layers line up when centered and
     * separate as you scroll — not a permanent offset from page top.
     * Images are not transformed; only each frame wrapper moves.
     */
    function apply(): void {
      rafId = 0;
      const vh = window.innerHeight || 1;
      const viewportMid = vh * 0.5;

      const panels = document.querySelectorAll<HTMLElement>(
        "[data-stock-depth-panel]",
      );

      for (const panel of panels) {
        const pr = panel.getBoundingClientRect();
        const centerY = pr.top + pr.height * 0.5;
        const norm = Math.max(
          -1,
          Math.min(1, (centerY - viewportMid) / (vh * 0.36)),
        );

        const layers = [
          ...panel.querySelectorAll<HTMLElement>("[data-stock-depth-layer]"),
        ];
        const n = layers.length;
        if (n === 0) continue;

        const mid = (n - 1) / 2;

        for (const layer of layers) {
          const idx = Number.parseInt(
            layer.dataset.depthIndex ??
              layer.getAttribute("data-depth-index") ??
              "0",
            10,
          );
          const base = Number.parseFloat(
            layer.dataset.baseRotate ??
              layer.getAttribute("data-base-rotate") ??
              "0",
          );
          if (Number.isNaN(base)) continue;

          const depth = idx - mid;
          const parallaxY = norm * 24 * depth;
          const zDepth = depth * 16;

          layer.style.transform = `rotate(${base}deg) translate3d(0, ${parallaxY.toFixed(2)}px, ${zDepth}px)`;
        }
      }
    }

    function onScrollOrResize(): void {
      if (rafId !== 0) return;
      rafId = window.requestAnimationFrame(apply);
    }

    apply();
    window.addEventListener("scroll", onScrollOrResize, { passive: true });
    window.addEventListener("resize", onScrollOrResize);
    window.visualViewport?.addEventListener("scroll", onScrollOrResize, {
      passive: true,
    });
    window.visualViewport?.addEventListener("resize", onScrollOrResize);
  }

  initStockImageScrollDepth();
</script>
