---
import "../styles/global.css";
import Container from "../components/Container.astro";
import Logo from "../components/Logo.astro";
import FacebookIcon from "../components/icons/FacebookIcon.astro";
import GitHubIcon from "../components/icons/GitHubIcon.astro";
import GooglePlayIcon from "../components/icons/GooglePlayIcon.astro";
import YouTubeIcon from "../components/icons/YouTubeIcon.astro";

type Props = {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: "website" | "article";
};

const { title, description, canonicalPath, ogImage, ogType } = Astro.props;

const site = {
  name: "Khonsu Development",
  description: description ?? "Modern educational apps that make learning niche topics immersive, fun, and accessible.",
  url: (Astro.site?.toString() ?? "https://www.khonsu.eu").replace(/\/$/, ""),
};

const canonicalUrl = canonicalPath ? new URL(canonicalPath, site.url).toString() : undefined;
const ogImageUrl = ogImage ? (ogImage.startsWith("http") ? ogImage : `${site.url}${ogImage}`) : `${site.url}/og.svg`;

const pathname = Astro.url?.pathname ?? "";
const showAlphabetsFacebook = pathname.startsWith("/alphabets");
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Alegreya+Sans+SC:wght@600;700&family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Noto+Serif:wght@600;700&family=Urbanist:wght@600;700;800&display=swap"
    />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:type" content={ogType ?? "website"} />
    <meta property="og:site_name" content={site.name} />
    {canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>

  <body class="min-h-screen overflow-x-hidden bg-zinc-950 text-zinc-50 antialiased">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-3 focus:py-2 focus:text-zinc-950"
    >
      Skip to content
    </a>

    <header class="fixed inset-x-0 top-0 z-40 border-b border-white/10 bg-zinc-900/25 backdrop-blur">
      <Container as="nav" class="flex h-16 items-center justify-between">
        <a href="/" class="group inline-flex items-center gap-2">
          <Logo class="text-sm" />
        </a>

        <div class="hidden items-center gap-6 text-sm text-zinc-200 sm:flex">
          <a class="hover:text-white" href="/apps">Apps</a>
          <a class="hover:text-white" href="/about">About</a>
          <a class="hover:text-white" href="/contact">Contact</a>
        </div>

        <details class="relative sm:hidden">
          <summary
            class="inline-flex items-center justify-center rounded-lg p-2 text-zinc-200 ring-1 ring-white/10 hover:bg-white/5 hover:text-white focus-visible:outline focus-visible:outline-offset-4 focus-visible:outline-white/60"
            aria-label="Open menu"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
            >
              <path d="M4 6h16"></path>
              <path d="M4 12h16"></path>
              <path d="M4 18h16"></path>
            </svg>
          </summary>
          <div
            class="absolute right-0 mt-3 w-48 overflow-hidden rounded-xl bg-zinc-950/95 shadow-lg ring-1 ring-white/10 backdrop-blur"
          >
            <div class="flex flex-col p-2 text-sm text-zinc-200">
              <a
                class="rounded-lg px-3 py-2 hover:bg-white/5 hover:text-white focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-white/60"
                href="/apps"
              >
                Apps
              </a>
              <a
                class="rounded-lg px-3 py-2 hover:bg-white/5 hover:text-white focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-white/60"
                href="/about"
              >
                About
              </a>
              <a
                class="rounded-lg px-3 py-2 hover:bg-white/5 hover:text-white focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-white/60"
                href="/contact"
              >
                Contact
              </a>
            </div>
          </div>
        </details>
      </Container>
    </header>

    <main id="content" class="scroll-mt-20 pt-16">
      <slot />
    </main>

    <footer class="border-t border-white/10">
      <Container class="py-10 text-sm text-zinc-300">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-3">
            <Logo class="text-sm text-zinc-200" />
          </div>

          <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
            <a
              class="inline-flex items-center justify-center text-zinc-300 transition hover:text-white focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-white/60"
              href="https://www.youtube.com/@khonsudevelopment"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="YouTube"
              title="YouTube"
            >
              <YouTubeIcon class="h-5 w-5" />
            </a>

            <a
              class="inline-flex items-center justify-center text-zinc-300 transition hover:text-white focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-white/60"
              href="https://github.com/khonsu-development"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              title="GitHub"
            >
              <GitHubIcon class="h-5 w-5" />
            </a>

            {
              showAlphabetsFacebook ? (
                <a
                  class="inline-flex items-center justify-center text-zinc-300 transition hover:text-white focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-white/60"
                  href="https://www.facebook.com/alphabetsapp"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Facebook (World of Alphabets)"
                  title="Facebook"
                >
                  <FacebookIcon class="h-5 w-5" />
                </a>
              ) : null
            }

            <a
              class="inline-flex items-center justify-center text-zinc-300 transition hover:text-white focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-white/60"
              href="https://play.google.com/store/apps/dev?id=5635874583313520174"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Google Play"
              title="Google Play"
            >
              <GooglePlayIcon class="h-5 w-5" />
            </a>
            <a class="hover:text-white" href="/terms"> Website Terms </a>
            <a class="hover:text-white" href="/privacy"> Website Privacy </a>
          </div>
        </div>
        <div class="mt-6 text-xs text-zinc-500">
          © {new Date().getFullYear()} Khonsu Development. All rights reserved.
        </div>
      </Container>
    </footer>
  </body>
</html>
