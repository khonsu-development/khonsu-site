---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import AppCard from "../components/AppCard.astro";

const allApps = await getCollection("apps");
const order = ["world-of-alphabets", "world-of-dinosaurs", "world-of-communism", "freestyle-rap"] as const;

const apps = order
  .map((id) => allApps.find((a) => a.id === `${id}.mdx`))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));
---

<BaseLayout
  title="Khonsu Development | Educational apps for curious minds"
  description="Khonsu Development builds educational apps for curious minds: beautiful, structured deep dives into niche topics, made for quick sessions or long rabbit holes."
  canonicalPath="/"
>
  <section class="hero-with-stars relative -mt-16 overflow-hidden pt-16">
    <div class="hero-video-wrap absolute inset-0 z-0">
      <video
        class="h-full min-h-full w-full object-cover object-center"
        data-hero-video-parallax
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/videos/stars-hero-poster.jpg"
        aria-hidden="true"
      >
        <source src="/videos/stars-hero-vp9.webm" type="video/webm" />
        <source src="/videos/stars-hero-h264.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="pointer-events-none absolute inset-0 z-[1] bg-zinc-950/45"></div>
    <div class="pointer-events-none absolute inset-0 z-[2] opacity-70">
      <div
        class="absolute -top-32 left-1/2 h-[520px] w-[920px] -translate-x-1/2 rounded-full bg-gradient-to-tr from-indigo-500/20 via-fuchsia-500/20 to-amber-400/10 blur-3xl"
      >
      </div>
      <div
        class="absolute -bottom-40 left-1/2 h-[520px] w-[920px] -translate-x-1/2 rounded-full bg-gradient-to-tr from-emerald-400/10 via-cyan-400/10 to-indigo-500/10 blur-3xl"
      >
      </div>
    </div>

    <div class="relative z-[3] mx-auto w-full max-w-6xl px-5 py-16 sm:py-24">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold tracking-wide text-zinc-300">Learned anything fun today?</p>
        <h1 class="mt-4 text-4xl font-black tracking-tight text-white sm:text-6xl">
          Educational apps for deep dives into niche worlds.
        </h1>
        <p class="mt-5 text-base leading-relaxed text-zinc-200 sm:text-lg">
          From ancient alphabets to prehistoric giants and political history, Khonsu apps turn curiosity into a clean,
          satisfying learning flow.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a class="btn btn-primary" href="/apps"> Discover our apps </a>
          <a class="btn btn-secondary" href="/about"> Why Khonsu? </a>
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-3">
          <div class="card p-5">
            <div class="text-sm font-semibold text-white">Expertly crafted</div>
            <div class="mt-2 text-sm text-zinc-300">
              Clear structure, careful research, and delightful presentation.
            </div>
          </div>
          <div class="card p-5">
            <div class="text-sm font-semibold text-white">Learn at your pace</div>
            <div class="mt-2 text-sm text-zinc-300">Five minutes or fifty, the experience fits your day.</div>
          </div>
          <div class="card p-5">
            <div class="text-sm font-semibold text-white">Interactive and fun</div>
            <div class="mt-2 text-sm text-zinc-300">Quizzes, exploration, and a sense of progress.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-white/10 py-16 sm:py-20">
    <Container>
      <div class="max-w-2xl">
        <h2 class="text-2xl font-black tracking-tight sm:text-4xl">Discover our apps</h2>
        <p class="mt-4 text-zinc-300">
          A growing “World of Apps”, one focused topic at a time. Each app is designed for clarity, momentum, and that
          “just one more page” feeling.
        </p>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          apps.map((app) => (
            <AppCard
              app={app}
              href={
                app.data.websiteUrl && app.data.websiteUrl.startsWith("/")
                  ? app.data.websiteUrl
                  : `/apps/${app.id.replace(/\.(md|mdx)$/, "")}`
              }
            />
          ))
        }
      </div>

      <div class="mt-10">
        <a class="btn btn-secondary" href="/apps"> Browse all apps </a>
      </div>
    </Container>
  </section>

  <style>
    @media (prefers-reduced-motion: reduce) {
      .hero-video-wrap {
        display: none;
      }

      .hero-with-stars {
        background-image: url("/videos/stars-hero-poster.jpg");
        background-position: center;
        background-size: cover;
      }
    }

    [data-hero-video-parallax] {
      will-change: transform;
      transform: translate3d(0, 0, 0) scale(1.14);
      transform-origin: center;
      backface-visibility: hidden;
    }
  </style>

  <script>
    function initHomeHeroVideoParallax(): void {
      const video = document.querySelector<HTMLElement>("[data-hero-video-parallax]");
      if (!(video instanceof HTMLElement)) return;

      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        video.style.removeProperty("transform");
        return;
      }

      const maxPx = 160;
      const strength = 0.22;
      let rafId = 0;

      function apply(): void {
        rafId = 0;
        const travel = Math.min(window.scrollY * strength, maxPx);
        video.style.transform = `translate3d(0, ${travel.toFixed(2)}px, 0) scale(1.14)`;
      }

      function onScrollOrResize(): void {
        if (rafId !== 0) return;
        rafId = window.requestAnimationFrame(apply);
      }

      apply();
      window.addEventListener("scroll", onScrollOrResize, { passive: true });
      window.addEventListener("resize", onScrollOrResize);
      window.visualViewport?.addEventListener("scroll", onScrollOrResize, { passive: true });
      window.visualViewport?.addEventListener("resize", onScrollOrResize);
    }

    initHomeHeroVideoParallax();
  </script>
</BaseLayout>
