---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import { CONTACT_EMAIL, CONTACT_EMAIL_MAILTO } from "../constants";
---

<BaseLayout
  title="Contact | Khonsu Development"
  description="Contact Khonsu Development with feedback, topic suggestions, bug reports, or collaboration ideas."
  canonicalPath="/contact"
>
  <section
    data-contact-hero
    class="relative isolate -mt-16 flex min-h-[min(60vh,560px)] flex-col justify-center overflow-hidden border-b border-white/10 pt-16 sm:min-h-[min(64vh,640px)]"
  >
    <div
      data-contact-hero-parallax
      class="pointer-events-none absolute inset-x-0 top-[-15%] bottom-[-15%] z-0 will-change-transform"
      aria-hidden="true"
    >
      <div
        class="absolute inset-0 bg-cover bg-center bg-no-repeat"
        style="background-image: url('/stock/landscape/forest-2.jpg')"
      >
      </div>
      <div
        class="absolute inset-0"
        style="background: linear-gradient(
          to bottom,
          rgba(9, 9, 11, 0.18) 0%,
          rgba(9, 9, 11, 0.26) 18%,
          rgba(9, 9, 11, 0.34) 36%,
          rgba(9, 9, 11, 0.46) 52%,
          rgba(9, 9, 11, 0.6) 66%,
          rgba(9, 9, 11, 0.76) 79%,
          rgba(9, 9, 11, 0.9) 90%,
          rgb(9, 9, 11) 100%
        );"
      >
      </div>
    </div>
    <Container class="relative z-10 py-16 sm:py-24">
      <div class="max-w-2xl">
        <h1
          class="text-3xl font-black tracking-tight text-white sm:text-5xl"
          style="text-shadow: 0 0.06em 0.35em rgba(0, 0, 0, 0.65), 0 0.12em 0.85em rgba(0, 0, 0, 0.45);"
        >
          Contact
        </h1>
        <p
          class="mt-4 text-zinc-50"
          style="text-shadow: 0 0.08em 0.3em rgba(0, 0, 0, 0.55), 0 0.1em 0.65em rgba(0, 0, 0, 0.4);"
        >
          Got feedback, a bug report, or a niche topic you’d love to explore? Send it over (collaborations welcome too).
        </p>
      </div>
    </Container>
  </section>

  <section class="py-12 sm:py-16">
    <Container>
      <div class="max-w-2xl">
        <div class="card p-6">
          <div class="text-sm font-semibold text-white">Email</div>
          <p class="mt-3 text-sm leading-relaxed text-zinc-300">
            Prefer email? Reach us at
            <span class="text-white">{CONTACT_EMAIL}</span>.
          </p>
          <div class="mt-4 flex flex-col gap-3 sm:flex-row">
            <a class="btn btn-primary" href={CONTACT_EMAIL_MAILTO}> Email us </a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <script is:inline>
    (function () {
      if (typeof window === "undefined") return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      const heroLayer = document.querySelector("[data-contact-hero-parallax]");
      if (!heroLayer) return;

      const heroFactor = 0.32;
      let ticking = false;

      function update() {
        const scrollY = window.scrollY;
        heroLayer.style.transform = `translate3d(0, ${scrollY * heroFactor}px, 0)`;
        ticking = false;
      }

      function onScroll() {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      }

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      update();
    })();
  </script>
</BaseLayout>
